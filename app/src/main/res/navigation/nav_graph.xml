<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.learningdashboardapp.ui.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.learningdashboardapp.ui.dashboard.DashboardFragment"
        android:label="Dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_courseDetailsFragment"
            app:destination="@id/courseDetailsFragment" />

    </fragment>

    <fragment
        android:id="@+id/courseDetailsFragment"
        android:name="com.example.learningdashboardapp.ui.CourseDetailsFragment"
        android:label="Course Details" />

</navigation>